# =============================================================================
# Aco Recycling Thermal Printer Service - Configuration
# =============================================================================
# Copy to .env and adjust values. All settings validated at startup (fail-fast).

# --- Server ---
HOST=127.0.0.1
PORT=8000
DEV_MODE=true                       # true: /mock/* endpoints + UI dev tools panel exposed; false: hidden
TRANSPORT_BACKEND=mock              # mock | real — flip to "real" for live printer; .env must have LAN_HOST or USB ids
# When set, /mock/* proxies to a standalone mock device service (default empty)
# e.g. http://127.0.0.1:9101
MOCK_DEVICE_CONTROL_URL=

# --- Connection ---
# usb | lan | empty (no auto-connect at startup).
# NOTE: inline `#` comments after `=` on an empty value are read as the value
# by python-dotenv, so the comment lives on its own line above.
DEFAULT_MODE=
# Printer IP, e.g. 192.168.1.50
LAN_HOST=
LAN_PORT=9100                       # ESC/POS standard raw socket port
# Hex string, e.g. 0x0fe6 (Cashino) — libusb path
USB_VENDOR_ID=
# Hex string, e.g. 0x811e — libusb path
USB_PRODUCT_ID=
# USB-CDC path, e.g. /dev/cu.usbserial-XXXX or /tmp/mock-printer-usb.
# When set, SerialTransport is used instead of libusb.
USB_DEVICE_PATH=

# --- Reconnect / Backoff / Breaker ---
CONNECT_RETRY_BASE_MS=500
CONNECT_RETRY_MAX_MS=30000          # exponential backoff cap (R9)
BACKOFF_FACTOR=2.0
BREAKER_THRESHOLD=5                 # consecutive failures before circuit opens

# --- Polling ---
POLL_INTERVAL_IDLE_MS=1000          # cached status refresh interval when idle
POLL_INTERVAL_PRINTING_MS=200       # finer-grain during print
STATUS_RETRY_MAX_IDLE=3
STATUS_RETRY_MAX_PRINTING=2

# --- Device Thresholds ---
OVERHEAT_STOP_C=65.0                # KP-302/KP-301H/KP-300: head stops at 65°C
OVERHEAT_RESUME_C=55.0              # KP-302: 55°C resume; KP-301H: 60°C

# --- Paper / Receipt Format ---
ROLL_LENGTH_MM=10000                # 10m default roll for prediction
PAPER_LOW_THRESHOLD_MM=500          # warning threshold
PAPER_WIDTH_COLS=32                 # 32 for 58mm paper, 48 for 80mm
PRINTER_CODEPAGE=cp857              # Turkish DOS; cp1254 alternative
USE_LIRA_SYMBOL=false               # false → "TL"; true → raw byte ₺ (cihaza bağlı)
LOCAL_TIMEZONE=Europe/Istanbul      # IANA zone for receipt timestamp; logs stay UTC

# --- Job Store ---
JOBS_DB_PATH=./jobs.db
REPRINT_MAX_AGE_HOURS=24            # jobs older than this → 410 Gone on reprint (R7)
JOB_RETENTION_DAYS=7                # sliding-window hard-delete older jobs from jobs.db

# --- Image Upload ---
MAX_IMAGE_BYTES=2097152             # 2 MB hard cap (R6)
MAX_RECEIPT_BYTES=30720             # G7 — rendered ESC/POS payload hard cap (protects 8-64KB printer buffer)

# --- Print-done detection (GS r 1 fence, per Cashino KP-300 manual p.63) ---
WAIT_FOR_PRINT_DONE=true            # block the device lock until the printer drains the buffer past the fence
WAIT_FOR_PRINT_TIMEOUT_MS=5000      # fence-read timeout (CommError if buffer doesn't drain in time)
MOCK_PRINT_DELAY_MS_PER_LINE=10     # mock device simulates real Cashino feed speed (10ms/line ≈ 250mm/s)

# --- Logging ---
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=jsonl
LOG_DIR=./logs
LOG_RETENTION_DAYS=7

# --- UI ---
UI_POLL_INTERVAL_MS=1500            # status panel polling cadence

# --- Auth (Bonus) ---
# Bearer token guarding PATCH /config; empty disables auth
CONFIG_PATCH_TOKEN=
PRINT_RATE_LIMIT_PER_MIN=10         # per-IP rate cap on POST /print/* (0 = disabled)

# --- Mock Device (only used when transport = mock) ---
MOCK_PAPER_INITIAL_LINES=500
MOCK_PAPER_LOW_THRESHOLD=50
MOCK_TEMP_MIN=20.0
MOCK_TEMP_MAX=85.0
MOCK_INITIAL_TEMP=25.0
MOCK_COOL_RATE=0.5                  # °C/sec when idle
MOCK_HEAT_RATE=2.0                  # °C/sec when printing
